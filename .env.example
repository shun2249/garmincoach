# 複製成 .env 後填入自己的帳號（chmod 600 .env）。.env 已在 .gitignore，不會進 git。
# Garmin Connect 登入資訊（第一次登入後 token 會存到 GARMINTOKENS，之後不再需要密碼）
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password
# 若使用 garmin.cn 帳號設成 1
GARMIN_IS_CN=0
# Token 存放目錄（預設 ~/.garminconnect）
GARMINTOKENS=~/.garminconnect
# 資料目錄（SQLite、原始 JSON、知識庫、log；預設 ./data）
# GARMIN_COACH_DATA=./data
# Garmin API 每次呼叫間隔秒數（太短會 429）
# GARMIN_API_PAUSE=0.4

# Garmin 活動天氣 API 回傳的單位（imperial = °F / mph，Garmin 預設；metric 則不轉換）
GARMIN_WEATHER_UNITS=imperial

# 外部資料（Open-Meteo 空氣品質，免金鑰）。設 0 可關閉
EXTERNAL_AQI=1

# AI 教練對話（OpenAI Responses API）
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna
# 推理強度 none/low/medium/high，空白用模型預設
OPENAI_REASONING=
# 結束萃取（摘要/補記）用的便宜模型，空白則用主模型
OPENAI_EXTRACT_MODEL=gpt-6-luna

# Telegram 介面：python -m garmin_coach telegram
# TELEGRAM_BOT_TOKEN 向 @BotFather 申請；TELEGRAM_ALLOWED_USERS 填自己的 Telegram user id（先留空，對 bot 講話它會回你的 id）
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_IDLE_MINUTES=30

# 每日 OpenAI 對話費用上限（美元），超過就暫停回答；0 = 不限制
OPENAI_DAILY_BUDGET_USD=2

# 分流：深入問題（課表/策略/傷痛/多因素）用的模型，空白 = 不分流；OPENAI_ROUTER=auto/simple/deep
OPENAI_DEEP_MODEL=gpt-6.1-sol
OPENAI_ROUTER=auto

# 問答重用：深入題回答存起來；相似度 ≥ 門檻（初篩）且便宜模型確認是同一個請求的，改由便宜模型更新舊回答；0 = 關閉
REUSE_SIMILARITY=0
REUSE_DAYS=30

# 網路搜尋（OpenAI web_search；費用高，只在本地資料拿不到時放行，結果完整記錄並快取）
WEB_SEARCH_ENABLED=1
WEB_SEARCH_MODEL=                 # 空白 = OPENAI_MODEL
WEB_SEARCH_CONTEXT=medium         # low / medium / high
WEB_SEARCH_MAX_CALLS=3            # 一次子請求最多幾次 web_search 呼叫
WEB_SEARCH_DAILY_MAX=5            # 每天最多放行幾次（快取命中不算）
WEB_SEARCH_PER_CONVERSATION=3     # 每段對話最多放行幾次
WEB_SEARCH_CALL_USD=0.01          # 每次 web_search 呼叫的工具費估算（對帳單校正）
WEB_CACHE_DAYS=90                 # 快取有效天數；「未找到」的結果只保留 WEB_CACHE_DAYS_NOTFOUND 天
WEB_CACHE_DAYS_NOTFOUND=14
WEB_CACHE_SIMILARITY=0.85         # 相似查詢直接命中；介於 WEB_CACHE_MAYBE 與此之間由便宜模型確認
WEB_CACHE_MAYBE=0.70
WEB_KB_FLOOR=0.45                 # 查詢與論文知識庫最高相似度低於此 → 直接放行；以上 → 便宜模型判斷知識庫能否回答
WEB_SEARCH_COUNTRY=TW             # 搜尋結果偏向的國家（ISO 兩碼）
WEB_SEARCH_TIMEZONE=Asia/Taipei   # 搜尋時的時區（IANA）

# 論文知識庫（kb build）：PubMed E-utilities 的禮貌參數，可空白；不要填 Garmin 帳號
PUBMED_EMAIL=

# 預建知識庫（kb download）的下載位置：預設是作者掛在 GitHub Release 的 knowledge.db.xz；可改成自己的網址或本機 .xz 檔
# KB_PACK_URL=https://github.com/shun2249/garmincoach/releases/download/kb-2026-10-28/knowledge.db.xz
